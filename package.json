{
	"name": "cognitive-razor",
	"version": "1.0.0",
	"description": "Cognitive Razor - 公理化知识管理插件",
	"main": "main.js",
	"type": "module",
	"packageManager": "npm@11.9.0",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"check": "tsc --noEmit --skipLibCheck && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:test": "tsc -p tsconfig.test.json --noEmit --skipLibCheck",
		"build": "npm run check && node esbuild.config.mjs production",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --run --coverage",
		"prompts:generate": "node scripts/generate-prompts.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare-release": "npm run build",
		"lint": "eslint src main.ts --ext .ts,.svelte"
	},
	"keywords": [
		"obsidian",
		"knowledge-management",
		"ai"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.16.0",
		"@types/node": "^22.10.1",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.15",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.4",
		"eslint": "^9.16.0",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "^4.3.0",
		"globals": "^16.5.0",
		"happy-dom": "^20.0.11",
		"obsidian": "1.13.1",
		"svelte": "^5.51.3",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.17.0",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"yaml": "^2.8.3"
	}
}
